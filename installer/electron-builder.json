{
  "appId": "app.zerocord.installer",
  "productName": "ZeroCord Installer",
  "asar": false,
  "extraMetadata": {
    "main": "installer/main.js",
    "name": "zerocord-installer"
  },
  "files": [
    "installer/**",
    "!installer/splash.bmp",
    "!installer/electron-builder.json",
    "src/**"
  ],
  "directories": {
    "output": "dist/installer"
  },
  "win": {
    "target": "portable",
    "icon": "src/icons/installer.ico",
    "artifactName": "ZeroCord-Installer.exe"
  },
  "portable": {
    "artifactName": "ZeroCord-Installer.exe",
    "splashImage": "installer/splash.bmp",
    "useZip": true
  },
  "compression": "normal"
}
