{
  "name": "zerocord",
  "productName": "ZeroCord",
  "version": "2.0.0",
  "description": "A Discord client mod with 370+ plugins, themes, an animated background and its own plugins, all inside Discord's settings.",
  "license": "GPL-3.0-or-later",
  "author": "odeiofavelado",
  "repository": {
    "type": "git",
    "url": "https://github.com/odeiofavelado/ZeroCord.git"
  },
  "main": "src/standalone.js",
  "scripts": {
    "start": "electron .",
    "installer": "electron installer/main.js",
    "build": "electron-builder --win portable",
    "build:installer": "electron-builder --config installer/electron-builder.json"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "app.zerocord",
    "productName": "ZeroCord",
    "files": [
      "src/**"
    ],
    "directories": {
      "output": "dist/app"
    },
    "win": {
      "target": "portable",
      "icon": "src/icons/discord.ico"
    }
  }
}
